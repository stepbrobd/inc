From 7fe7ef0c6766f58ec26fdbab8635d5b530c2a2e6 Mon Sep 17 00:00:00 2001
From: Yifei Sun <ysun@hey.com>
Date: Fri, 28 Nov 2025 14:04:17 +0100
Subject: [PATCH] stepbrobd: custom deployment patch

---
 server/core/src/https/middleware/caching.rs |  2 +-
 server/core/src/https/mod.rs                | 16 ++++++++--------
 server/core/templates/base.html             |  3 ++-
 server/core/templates/base_htmx.html        |  3 ++-
 4 files changed, 13 insertions(+), 11 deletions(-)

diff --git a/server/core/src/https/middleware/caching.rs b/server/core/src/https/middleware/caching.rs
index c171870..bd2e46e 100644
--- a/server/core/src/https/middleware/caching.rs
+++ b/server/core/src/https/middleware/caching.rs
@@ -10,7 +10,7 @@ pub async fn dont_cache_me(request: Request<Body>, next: Next) -> Response {
     let mut response = next.run(request).await;
     response.headers_mut().insert(
         header::CACHE_CONTROL,
-        HeaderValue::from_static("no-store, no-cache, max-age=0"),
+        HeaderValue::from_static("private, no-store, no-cache, max-age=0"),
     );
     response
         .headers_mut()
diff --git a/server/core/src/https/mod.rs b/server/core/src/https/mod.rs
index 6ce32af..768beee 100644
--- a/server/core/src/https/mod.rs
+++ b/server/core/src/https/mod.rs
@@ -222,12 +222,12 @@ pub async fn create_https_server(
             "default-src 'self'; ",
             "base-uri 'none'; ",
             "form-action 'self'; ",
-            "frame-ancestors 'none'; ",
+            "frame-ancestors 'self' https://ysun.co https://*.ysun.co; ",
             "img-src 'self' data:; ",
             "worker-src 'none'; ",
-            "script-src 'self' 'unsafe-eval'{};",
-            // https://datatracker.ietf.org/doc/html/rfc9700#name-clickjacking
-            "frame-ancestors 'none'; ",
+            "script-src 'self' 'unsafe-eval'{} https://stats.ysun.co; ",
+            "connect-src 'self' https://stats.ysun.co; ",
+            "report-uri https://ysun.co/csp;"
         ),
         js_checksums
     );
@@ -247,12 +247,12 @@ pub async fn create_https_server(
         concat!(
             "default-src 'self'; ",
             "base-uri 'none'; ",
-            "frame-ancestors 'none'; ",
+            "frame-ancestors 'self' https://ysun.co https://*.ysun.co; ",
             "img-src 'self' data:; ",
             "worker-src 'none'; ",
-            "script-src 'self' 'unsafe-eval'{};",
-            // https://datatracker.ietf.org/doc/html/rfc9700#name-clickjacking
-            "frame-ancestors 'none'; ",
+            "script-src 'self' 'unsafe-eval'{} https://stats.ysun.co; ",
+            "connect-src 'self' https://stats.ysun.co; ",
+            "report-uri https://ysun.co/csp;"
         ),
         js_checksums
     );
diff --git a/server/core/templates/base.html b/server/core/templates/base.html
index 2337d1a..e2e7ed5 100644
--- a/server/core/templates/base.html
+++ b/server/core/templates/base.html
@@ -2,7 +2,7 @@
 <html lang="en">
 	<head>
 		<meta charset="utf-8" />
-		<meta name="theme-color" content="white" />
+		<meta name="theme-color" content="#2e3440" />
 		<meta name="viewport" content="width=device-width" />
 
 		<title>(% block title %)(( title )) - Kanidm(% endblock %)</title>
@@ -24,6 +24,7 @@
 			href="/pkg/override.css?v=((crate::https::cache_buster::get_cache_buster_key()))" />
 
 		(% block head %)(% endblock %)
+                <script defer data-domain="sso.ysun.co" src="https://stats.ysun.co/js/script.file-downloads.hash.outbound-links.js"></script>
 	</head>
 	<body class="flex-column d-flex h-100">
 		(% block body %)(% endblock %)
diff --git a/server/core/templates/base_htmx.html b/server/core/templates/base_htmx.html
index 60bb2f4..016ae3a 100644
--- a/server/core/templates/base_htmx.html
+++ b/server/core/templates/base_htmx.html
@@ -2,7 +2,7 @@
 <html lang="en">
 	<head>
 		<meta charset="utf-8" />
-		<meta name="theme-color" content="white" />
+		<meta name="theme-color" content="#2e3440" />
 		<meta name="viewport" content="width=device-width" />
 		<!-- https://htmx.org/docs/#response-handling -->
 		<meta name="htmx-config" content='{
@@ -35,6 +35,7 @@
 			href="/pkg/override.css?v=((crate::https::cache_buster::get_cache_buster_key()))" />
 
 		(% block head %)(% endblock %)
+                <script defer data-domain="sso.ysun.co" src="https://stats.ysun.co/js/script.file-downloads.hash.outbound-links.js"></script>
 	</head>
 	<body hx-boost="false" class="flex-column d-flex h-100">
 		(% block body %)(% endblock %)
-- 
2.55.0

